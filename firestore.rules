rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.uid == "0HtqKqXRaLN9hQ34QlPmG4nB2fi1";
    }
    function acessoOk(uid) {
      return exists(/databases/$(database)/documents/acessos/$(uid))
        && get(/databases/$(database)/documents/acessos/$(uid)).data.status == "liberado"
        && (get(/databases/$(database)/documents/acessos/$(uid)).data.validoAte == null
            || get(/databases/$(database)/documents/acessos/$(uid)).data.validoAte > request.time);
    }
    function vagasDoc() {
      return /databases/$(database)/documents/publico/vagas;
    }
    function cotaDoc(uid) {
      return /databases/$(database)/documents/cotas/$(uid);
    }
    function convite(cod) {
      return get(/databases/$(database)/documents/convites/$(cod)).data;
    }
    match /data/users/{uid}/{rest=**} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.uid == uid && (isAdmin() || acessoOk(uid));
    }
    match /cadastros/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      allow read: if isAdmin();
    }
    match /acessos/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow read, write: if isAdmin();
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(["status", "validoAte", "convite", "criadoEm"])
        && request.resource.data.status == "liberado"
        && convite(request.resource.data.convite).usado == false
        && getAfter(/databases/$(database)/documents/convites/$(request.resource.data.convite)).data.usadoPor == request.auth.uid
        && ((convite(request.resource.data.convite).dias == 0 && request.resource.data.validoAte == null)
            || (convite(request.resource.data.convite).dias > 0
                && request.resource.data.validoAte is timestamp
                && request.resource.data.validoAte <= request.time + duration.value(convite(request.resource.data.convite).dias + 1, "d")));
    }
    match /sugestoes/{id} {
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid
        && request.resource.data.texto is string && request.resource.data.texto.size() <= 4000;
      allow read, update, delete: if isAdmin();
    }
    match /publico/{doc} {
      allow read: if true;
      allow write: if isAdmin();
      // Colega liberado gasta 1 vaga ao criar um convite (sempre junto com o convite)
      allow update: if doc == "vagas" && request.auth != null && acessoOk(request.auth.uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["usadas"])
        && request.resource.data.usadas == resource.data.usadas + 1
        && request.resource.data.usadas <= resource.data.total;
    }
    match /cotas/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow read, write: if isAdmin();
      allow create: if request.auth != null && request.auth.uid == uid && acessoOk(uid)
        && request.resource.data.keys().hasOnly(["n"]) && request.resource.data.n == 1
        && 1 <= get(vagasDoc()).data.get("porUsuario", 3);
      allow update: if request.auth != null && request.auth.uid == uid && acessoOk(uid)
        && request.resource.data.keys().hasOnly(["n"]) && request.resource.data.n == resource.data.n + 1
        && request.resource.data.n <= get(vagasDoc()).data.get("porUsuario", 3);
    }
    match /config/{doc} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
    match /convites/{cod} {
      allow get: if request.auth != null;
      allow read, write: if isAdmin();
      allow list: if request.auth != null && resource.data.criadoPor == request.auth.uid;
      // Colega liberado cria convite: gasta 1 da cota dele e 1 vaga da fase beta, tudo junto
      allow create: if request.auth != null && acessoOk(request.auth.uid)
        && request.resource.data.keys().hasOnly(["dias", "nome", "usado", "criadoEm", "criadoPor"])
        && request.resource.data.criadoPor == request.auth.uid
        && request.resource.data.usado == false
        && request.resource.data.nome is string && request.resource.data.nome.size() <= 80
        && request.resource.data.dias == get(vagasDoc()).data.get("diasConvite", 30)
        && getAfter(vagasDoc()).data.usadas == get(vagasDoc()).data.usadas + 1
        && getAfter(vagasDoc()).data.usadas <= get(vagasDoc()).data.total
        && getAfter(cotaDoc(request.auth.uid)).data.n == (exists(cotaDoc(request.auth.uid)) ? get(cotaDoc(request.auth.uid)).data.n : 0) + 1;
      allow update: if request.auth != null
        && resource.data.usado == false
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["usado", "usadoPor", "usadoEm"])
        && request.resource.data.usado == true
        && request.resource.data.usadoPor == request.auth.uid;
    }
  }
}
